# URL do projeto Supabase (Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Service Role Key — NUNCA exponha no frontend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Segredo para assinar JWTs — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio

# Duração do token (ex: 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# Porta do servidor
PORT=3000

# --- Envio de e-mail do código OTP de recuperação de senha (OPCIONAL) ---
# Sem isto, o backend roda em "modo dev": o código aparece no console.
# Para enviar de verdade, crie conta em https://resend.com (grátis 100/dia)
# e preencha abaixo:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM="Acessecidade <onboarding@resend.dev>"
